SERVICE_NAME=ingress-egress-tracking-service
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8100

# NATS Configuration
NATS_URL=nats://136.119.107.99:4222
NATS_FRAME_SUBJECT=frames.ml.tracking
NATS_LINE_CONFIG_SUBJECT=config.tracking.lines
NATS_QUEUE_GROUP=tracking-service
NATS_MAX_PENDING=1000
NATS_CONSUMER_MODE=unified

# Kafka Configuration
KAFKA_BROKERS=136.119.107.99:9092
KAFKA_TOPIC_PREFIX=tracking.events
KAFKA_LINGER_MS=100

# MinIO Configuration
MINIO_BUCKET_NAME=vehicle-tracking
MINIO_ENDPOINT=136.119.107.99:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
# Model Configuration
CAR_MODEL_NAME=./Models/car_detection.pt
CAR_MODEL_CONFIDENCE=0.6
CAR_MODEL_IOU_THRESHOLD=0.4
MODEL_DEVICE=cuda:0

# Tracker Configuration
TRACKER_MAX_AGE=120
TRACKER_MIN_HITS=10

# Line Crossing Detection Parameters
CROSSING_DISTANCE_THRESHOLD=20.0
CROSSING_CONFIRMATION_FRAMES=3
CROSSING_HYSTERESIS=5.0

# Quality Configuration
MIN_CROP_AREA_RATIO=0.05
BLUR_THRESHOLD=100
PADDING_TO_CROP=0.1

# Save Configuration
SAVE_VEHICLE_CROPS=true
SAVE_CROSSING_EVENTS_ONLY=true

# Discord Notifications (Optional)
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_ON_CROSSING=false

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30

# Multi-Camera Production Settings
MAX_CAMERAS=10
MAX_TRACKS_PER_CAMERA=100
CAMERA_FRAME_TIMEOUT=5.0
ENABLE_PER_CAMERA_METRICS=true

# -----------------------------------------------------------------------------
# FRAME ROUTER SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
FACILITY_API_URL=http://136.119.107.99:3001
ALLOWED_ORIGIN=http://136.119.107.99:3002
# Worker Configuration
WORKER_ID=worker-1
WORKER_CAPACITY=100
WORKER_POLL_INTERVAL=30
WORKER_SHUTDOWN_TIMEOUT=30

# Frame Processing
FRAME_QUALITY=85
FRAME_FPS=30
FRAME_EXTRACT_TIMEOUT=30
FRAME_BUFFER_SIZE=100
FRAME_FORMAT=mjpeg
# Health Check
HEALTH_PORT=8383
HEALTH_CHECK_INTERVAL=30

# NATS Client Configuration
NATS_MAX_RECONNECT=10
NATS_RECONNECT_WAIT=2
NATS_MAX_PAYLOAD_MB=5
NATS_PUBLISH_TIMEOUT=5

BACKEND_API_TIMEOUT=10
BACKEND_API_RETRY_ATTEMPTS=3
BACKEND_API_RETRY_DELAY=1

# Playground Configuration
PLAYGROUND_MAX_FPS=30
PLAYGROUND_DEFAULT_FPS=5
PLAYGROUND_JPEG_QUALITY=85
PLAYGROUND_MAX_VIDEO_DURATION=300
# -----------------------------------------------------------------------------
# DISCORD NOTIFICATIONS CONFIGURATION (Frame Router Service)
# -----------------------------------------------------------------------------
# Enable/disable Discord webhook notifications for camera stream health alerts
DISCORD_ENABLED=true

# Discord Webhook URL - Get from: Discord Server Settings > Integrations > Webhooks
# IMPORTANT: Replace with your actual webhook URL or leave empty to disable
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1435944561032564748/eE9SGOEY3p148pogb8IIQQUD5HdtlFx_BPeYfSjH2FwMOM9MVgQY9vl5h2kSFxcrxyyV

# Bot display name in Discord messages
DISCORD_USERNAME=Frame Router Monitor

# Bot avatar image URL (optional)
DISCORD_AVATAR_URL=https://i.imgur.com/rM1xL0d.png

# Minimum seconds between duplicate notifications (prevents spam)
DISCORD_RATE_LIMIT_SECONDS=300

# Maximum retry attempts for failed webhook calls
DISCORD_MAX_RETRIES=3

# Notification Toggles (enable/disable specific notification types)
DISCORD_NOTIFY_RECOVERY_TRIGGERED=true    # Alert when automatic recovery starts
DISCORD_NOTIFY_RECOVERY_SUCCESS=true      # Alert when camera recovers successfully
DISCORD_NOTIFY_RECOVERY_FAILED=true       # Alert when recovery attempt fails
DISCORD_NOTIFY_MAX_ATTEMPTS=true          # CRITICAL: Alert when max recovery attempts reached
DISCORD_NOTIFY_FRAME_TIMEOUT=true         # Alert when no frames received for extended period
DISCORD_NOTIFY_FROZEN_CAMERA=true         # Alert when camera produces duplicate frames
DISCORD_NOTIFY_CONNECTION_LOST=true       # Alert when FFmpeg connection repeatedly fails

# Stream Recovery Configuration (determines when recovery notifications trigger)
STREAM_RECOVERY_ENABLED=true
STREAM_RECOVERY_CHECK_INTERVAL=600        # Health check every 10 minutes
STREAM_RECOVERY_FRAME_TIMEOUT=120         # Trigger recovery after 2 min without frames
STREAM_RECOVERY_MIN_FRAMES_IN_WINDOW=10   # Minimum frames expected in analysis window
STREAM_RECOVERY_MAX_ATTEMPTS=3            # Max recovery attempts before manual intervention
STREAM_RECOVERY_COOLDOWN_SECONDS=300      # Wait 5 minutes between recovery attempts
STREAM_RECOVERY_WINDOW_MINUTES=10         # Time window for frame analysis

# Stream Retry Configuration
STREAM_RETRY_INTERVAL=10                  # Seconds between retry attempts
STREAM_MAX_CONSECUTIVE_FAILURES=0         # 0 = infinite retries
STREAM_RECONNECT_TIMEOUT=5                # FFmpeg reconnect timeout in seconds
STREAM_HEALTH_CHECK_INTERVAL=30           # Health check interval in seconds

# Stream Health Monitoring
STREAM_HEALTH_FRAME_TIMEOUT=30            # Max seconds without frames before restart
STREAM_HEALTH_FIRST_FRAME_TIMEOUT=15      # Max seconds to receive first frame
STREAM_HEALTH_MIN_ACCEPTABLE_FPS=1.0      # Minimum FPS before warning
STREAM_HEALTH_MAX_DUPLICATE_FRAMES=60     # Max identical frames before warning
STREAM_HEALTH_FPS_CHECK_WINDOW=30         # Number of frames for FPS calculation
STREAM_HEALTH_WATCHDOG_INTERVAL=10        # Seconds between watchdog health checks
STREAM_HEALTH_STATS_LOG_INTERVAL=60       # Seconds between periodic stats logging

